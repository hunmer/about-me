{
  "name": "AI 图片生成",
  "id": "ai_image",
  "version": "1.2.1",
  "description": "调用 OpenAI 兼容图像 API 文生图，支持异步任务轮询；生成图片自动保存到本地，并用 json_dynamic_widget 渲染结果界面（后台触发时自动降级）",
  "icon": "star",
  "author": "Aboutme Team",
  "enabled": true,
  "type": "module",
  "autoRun": false,
  "inputs": [
    {
      "label": "图片描述",
      "key": "prompt",
      "type": "string",
      "required": true,
      "defaultValue": "",
      "description": "描述想生成的图片内容，越具体效果越好",
      "placeholder": "例如：一只戴墨镜的橘猫坐在沙滩上，日落背景"
    },
    {
      "label": "模型",
      "key": "model",
      "type": "select",
      "required": false,
      "defaultValue": "gpt-image-2",
      "options": [
        "gpt-image-1",
        "gpt-image-2",
        "sora_image",
        "nano-banana",
        "dall-e-3",
        "flux-pro-1.1",
        "flux-kontext-pro"
      ],
      "description": "留空时使用脚本配置中的默认模型"
    },
    {
      "label": "宽高比",
      "key": "aspectRatio",
      "type": "select",
      "required": false,
      "defaultValue": "1:1",
      "options": [
        "1:1",
        "16:9",
        "9:16",
        "4:3",
        "3:4",
        "3:2",
        "2:3"
      ],
      "description": "留空时使用脚本配置中的默认比例"
    }
  ],
  "triggers": [],
  "configFormFields": [
    {
      "name": "apiKey",
      "type": "password",
      "labelText": "API Key",
      "hintText": "图像服务的 Bearer Token（sk-...）",
      "initialValue": "",
      "required": true,
      "validationMessage": "请填写 API Key"
    },
    {
      "name": "baseUrl",
      "type": "text",
      "labelText": "API 地址",
      "hintText": "OpenAI 兼容图像 API 基础地址（不含 /v1）",
      "initialValue": "https://ai.comfly.chat",
      "required": true,
      "validationMessage": "请填写 API 地址"
    },
    {
      "name": "model",
      "type": "text",
      "labelText": "默认模型",
      "hintText": "gpt-image-1 / nano-banana / dall-e-3 ...",
      "initialValue": "gpt-image-2",
      "required": false
    },
    {
      "name": "aspectRatio",
      "type": "text",
      "labelText": "默认宽高比",
      "hintText": "1:1 / 16:9 / 9:16 ...",
      "initialValue": "1:1",
      "required": false
    },
    {
      "name": "n",
      "type": "number",
      "labelText": "生成数量",
      "hintText": "每次生成几张（1-4）",
      "initialValue": 1,
      "required": false
    },
    {
      "name": "proxy",
      "type": "text",
      "labelText": "网络代理（可选）",
      "hintText": "如 http://127.0.0.1:7890，留空自动使用系统代理",
      "initialValue": "",
      "required": false
    },
    {
      "name": "showUi",
      "type": "switchField",
      "labelText": "生成后自动展示界面",
      "hintText": "关闭后仅 toast 提示，不打开 json_dynamic_widget 结果页",
      "initialValue": true,
      "required": false
    }
  ],
  "builtIn": true
}
