{
  "name": "Unsplash 图片搜索",
  "id": "unsplash_search",
  "version": "1.0.0",
  "description": "高质量摄影图片搜索（api.unsplash.com/search/photos）：热链接展示 + 摄影师署名，支持数量/方向/排序/翻页；Access Key 保存在脚本本地配置，不硬编码",
  "icon": "star",
  "author": "Aboutme Team",
  "enabled": true,
  "type": "module",
  "autoRun": false,
  "inputs": [
    {
      "label": "搜索关键词",
      "key": "query",
      "type": "string",
      "required": true,
      "defaultValue": "",
      "description": "英文关键词效果最佳，如 mountain sunrise",
      "placeholder": "例如：mountain sunrise"
    },
    {
      "label": "数量",
      "key": "perPage",
      "type": "number",
      "required": false,
      "defaultValue": 10,
      "description": "每次返回几张（1-30），留空用脚本配置默认值"
    },
    {
      "label": "方向",
      "key": "orientation",
      "type": "select",
      "required": false,
      "defaultValue": "any",
      "options": [
        "any",
        "landscape",
        "portrait",
        "squarish"
      ],
      "description": "any = 不限方向"
    },
    {
      "label": "排序",
      "key": "orderBy",
      "type": "select",
      "required": false,
      "defaultValue": "relevant",
      "options": [
        "relevant",
        "latest"
      ],
      "description": "relevant = 相关度，latest = 最新"
    },
    {
      "label": "页码",
      "key": "page",
      "type": "number",
      "required": false,
      "defaultValue": 1,
      "description": "翻页用，配合数量每页可看更多结果"
    }
  ],
  "triggers": [],
  "configFormFields": [
    {
      "name": "accessKey",
      "type": "password",
      "labelText": "Access Key",
      "hintText": "Unsplash 应用的 Access Key（注意不是 Secret Key）",
      "initialValue": "",
      "required": true,
      "validationMessage": "请填写 Unsplash Access Key"
    },
    {
      "name": "perPage",
      "type": "number",
      "labelText": "默认数量",
      "hintText": "每次搜索返回几张（1-30）",
      "initialValue": 10,
      "required": false
    },
    {
      "name": "proxy",
      "type": "text",
      "labelText": "网络代理（可选）",
      "hintText": "如 http://127.0.0.1:7890，留空自动使用系统代理",
      "initialValue": "",
      "required": false
    },
    {
      "name": "showUi",
      "type": "switchField",
      "labelText": "搜索后自动展示界面",
      "hintText": "关闭后仅返回数据，不打开结果页",
      "initialValue": true,
      "required": false
    }
  ],
  "builtIn": true
}
