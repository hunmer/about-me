{
  "commands": {
    "app": {
      "script": "flutter",
      "args": ["run", "-d", "macos"],
      "envs": {
        "PROCM_WS_URL": "ws://127.0.0.1:7331/room",
        "PROCM_ROOM_ID": "aboutme",
        "PROCM_CLIENT_NAME": "aboutme-app"
      },
      "group": "aboutme",
      "desc": "Run the Flutter app on macOS with procm room logging (phone/emulator targets need the host LAN IP instead of 127.0.0.1)"
    },
    "app-windows": {
      "script": "flutter",
      "args": ["run", "-d", "windows"],
      "envs": {
        "PROCM_WS_URL": "ws://127.0.0.1:7331/room",
        "PROCM_ROOM_ID": "aboutme",
        "PROCM_CLIENT_NAME": "aboutme-app-windows"
      },
      "group": "aboutme",
      "desc": "Run the Flutter app on Windows with procm room logging"
    },
    "analyze": {
      "script": "flutter",
      "args": ["analyze"],
      "group": "aboutme",
      "desc": "Static analysis quality gate"
    },
    "server": {
      "script": "npm",
      "args": ["run", "dev"],
      "cwd": "packages/server-nodejs",
      "group": "aboutme",
      "desc": "Storage server (REST + admin panel + MCP /mcp) on port 8874, ts-node-dev hot reload"
    }
  }
}
